{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "QueueUp",
    "Audience": "QueueUp",
    "LifetimeHours": 12
  },
  "RateLimits": {
    "AuthAttemptsPerFiveMinutes": 10,
    "JoinsPerMinute": 20
  }
}
