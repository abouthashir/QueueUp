@baseUrl = http://localhost:5204
@queueId = c250ddb5-277c-4dd9-b1d6-e3b230bb69ac

### List all queues
GET {{baseUrl}}/api/queues

### Get the demo queue
GET {{baseUrl}}/api/queues/{{queueId}}

### Get a queue that does not exist (expect 404 with a message)
GET {{baseUrl}}/api/queues/22222222-2222-2222-2222-222222222222

### Not a valid Guid (expect 404 from the route constraint)
GET {{baseUrl}}/api/queues/abc

### Anu joins the demo queue (expect 201 Created)
# @name joinAnu
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{
  "customerName": "Anu"
}

### A walk-in customer joins without a name (expect 201, customerName null)
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{}

### Join a queue that does not exist (expect 404)
POST {{baseUrl}}/api/queues/22222222-2222-2222-2222-222222222222/tokens
Content-Type: application/json

{}

### View Anu's token (run "Anu joins" first)
GET {{baseUrl}}/api/tokens/{{joinAnu.response.body.$.id}}

### View a token that does not exist (expect 404)
GET {{baseUrl}}/api/tokens/33333333-3333-3333-3333-333333333333

### Staff pause the queue (expect 200, status Paused)
POST {{baseUrl}}/api/queues/{{queueId}}/pause

### Join while paused (expect 409 Conflict)
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{
  "customerName": "Meera"
}

### Staff open the queue again (expect 200, status Open)
POST {{baseUrl}}/api/queues/{{queueId}}/open

### Staff: Counter 1 calls next (200 with a token, or 204 if nobody is waiting)
POST {{baseUrl}}/api/queues/{{queueId}}/call-next
Content-Type: application/json

{
  "counterName": "Counter 1"
}

### Staff: call next without a counter name (expect 400)
POST {{baseUrl}}/api/queues/{{queueId}}/call-next
Content-Type: application/json

{}

### Rahul joins the demo queue
# @name joinRahul
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{
  "customerName": "Rahul"
}

### Staff: serve Anu (she must be Called first)
POST {{baseUrl}}/api/tokens/{{joinAnu.response.body.$.id}}/serve

### Staff: skip Rahul (he must be Called first)
POST {{baseUrl}}/api/tokens/{{joinRahul.response.body.$.id}}/skip

### Staff: Counter 2 recalls Rahul (he must be Skipped first)
POST {{baseUrl}}/api/tokens/{{joinRahul.response.body.$.id}}/recall
Content-Type: application/json

{
  "counterName": "Counter 2"
}

### Customer: Rahul cancels (only allowed while Waiting)
POST {{baseUrl}}/api/tokens/{{joinRahul.response.body.$.id}}/cancel

### Staff close the queue for the day (409 if someone is still being served)
POST {{baseUrl}}/api/queues/{{queueId}}/close

### Join after closing (expect 409: the queue is Closed)
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{
  "customerName": "Late arrival"
}

### Staff: Counter 1's dashboard
GET {{baseUrl}}/api/queues/{{queueId}}/dashboard?counterName=Counter 1

### Dashboard without a counter name (expect 400)
GET {{baseUrl}}/api/queues/{{queueId}}/dashboard

### SignalR handshake (Lesson 11)
POST {{baseUrl}}/hubs/queue/negotiate?negotiateVersion=1

### Owner signs up (Lesson 12)
# @name signup
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "Sunrise Clinic",
  "name": "Anil",
  "email": "anil@sunrise.test",
  "password": "test-password-1",
  "counterName": "Counter 1"
}

### Sign up again with the same email (expect 409)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "Another Clinic",
  "name": "Someone",
  "email": "ANIL@sunrise.test",
  "password": "test-password-2",
  "counterName": "Counter 1"
}

### Sign up with a short password (expect 400)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "Short Clinic",
  "name": "Sam",
  "email": "sam@short.test",
  "password": "short",
  "counterName": "Counter 1"
}

### Owner logs in
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": " Anil@Sunrise.test ",
  "password": "test-password-1"
}

### Log in with a wrong password (expect 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "anil@sunrise.test",
  "password": "wrong-password"
}
