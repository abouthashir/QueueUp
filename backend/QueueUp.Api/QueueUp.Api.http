@baseUrl = http://localhost:5204

# Lesson 12: run these from top to bottom after starting the API.
# Test accounts use the reserved .test domain and throwaway passwords. Never put a real password here.
# The four "first time only" requests give 409 when run again; that's expected.

@ownerToken = {{ownerLogin.response.body.$.token}}
@staffToken = {{staffLogin.response.body.$.token}}
@bankToken = {{bankLogin.response.body.$.token}}
@queueId = {{myQueues.response.body.$[0].id}}

### 1. Sunrise Clinic's owner signs up (first time only)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "Sunrise Clinic",
  "name": "Anil",
  "email": "anil@sunrise.test",
  "password": "test-password-1",
  "counterName": "Counter 1"
}

### 2. Sign up again with the same email (expect 409)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "Another Clinic",
  "name": "Someone",
  "email": "ANIL@sunrise.test",
  "password": "test-password-2",
  "counterName": "Counter 1"
}

### 3. Sign up with a short password (expect 400)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "Short Clinic",
  "name": "Sam",
  "email": "sam@short.test",
  "password": "short",
  "counterName": "Counter 1"
}

### 4. Log in with a wrong password (expect 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "anil@sunrise.test",
  "password": "wrong-password"
}

### 5. Sunrise's owner logs in
# @name ownerLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": " Anil@Sunrise.test ",
  "password": "test-password-1"
}

### 6. Owner creates a queue (first time only; it starts Closed)
POST {{baseUrl}}/api/queues
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "General OPD",
  "prefix": "a",
  "averageServiceMinutes": 5
}

### 7. Owner tries a queue with a bad prefix (expect 400)
POST {{baseUrl}}/api/queues
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Pharmacy",
  "prefix": "7",
  "averageServiceMinutes": 4
}

### 8. Owner lists their queues (sets {{queueId}} to the first one)
# @name myQueues
GET {{baseUrl}}/api/queues
Authorization: Bearer {{ownerToken}}

### 9. List queues without a pass (expect 401)
GET {{baseUrl}}/api/queues

### 10. Owner adds Reshma as staff at Counter 2 (first time only)
POST {{baseUrl}}/api/staff
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Reshma",
  "email": "reshma@sunrise.test",
  "password": "test-password-3",
  "counterName": "Counter 2"
}

### 11. Reshma logs in
# @name staffLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "reshma@sunrise.test",
  "password": "test-password-3"
}

### 12. Reshma tries to create a queue (expect 403: owners only)
POST {{baseUrl}}/api/queues
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "name": "Lab",
  "prefix": "L",
  "averageServiceMinutes": 10
}

### 13. Reshma opens the queue for the day
POST {{baseUrl}}/api/queues/{{queueId}}/open
Authorization: Bearer {{staffToken}}

### 14. Customer Meera joins (public, no pass)
# @name joinMeera
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{
  "customerName": "Meera"
}

### 15. Customer Ravi joins (public)
# @name joinRavi
POST {{baseUrl}}/api/queues/{{queueId}}/tokens
Content-Type: application/json

{
  "customerName": "Ravi"
}

### 16. Customer views Meera's token (public)
GET {{baseUrl}}/api/tokens/{{joinMeera.response.body.$.id}}

### 17. Reshma calls next (the counter comes from her pass: Counter 2)
POST {{baseUrl}}/api/queues/{{queueId}}/call-next
Authorization: Bearer {{staffToken}}

### 18. Reshma's dashboard
GET {{baseUrl}}/api/queues/{{queueId}}/dashboard
Authorization: Bearer {{staffToken}}

### 19. Reshma skips Meera (Meera must be Called)
POST {{baseUrl}}/api/tokens/{{joinMeera.response.body.$.id}}/skip
Authorization: Bearer {{staffToken}}

### 20. Reshma recalls Meera to her own counter
POST {{baseUrl}}/api/tokens/{{joinMeera.response.body.$.id}}/recall
Authorization: Bearer {{staffToken}}

### 21. Reshma serves Meera
POST {{baseUrl}}/api/tokens/{{joinMeera.response.body.$.id}}/serve
Authorization: Bearer {{staffToken}}

### 22. City Bank's owner signs up (first time only)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "businessName": "City Bank",
  "name": "Bina",
  "email": "bina@citybank.test",
  "password": "test-password-4",
  "counterName": "Desk 1"
}

### 23. City Bank's owner logs in
# @name bankLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "bina@citybank.test",
  "password": "test-password-4"
}

### 24. City Bank lists its queues (expect [] - none of Sunrise's)
GET {{baseUrl}}/api/queues
Authorization: Bearer {{bankToken}}

### 25. City Bank opens Sunrise's dashboard (expect 404)
GET {{baseUrl}}/api/queues/{{queueId}}/dashboard
Authorization: Bearer {{bankToken}}

### 26. City Bank calls next on Sunrise's queue (expect 404)
POST {{baseUrl}}/api/queues/{{queueId}}/call-next
Authorization: Bearer {{bankToken}}

### 27. City Bank closes Sunrise's queue (expect 404)
POST {{baseUrl}}/api/queues/{{queueId}}/close
Authorization: Bearer {{bankToken}}

### 28. City Bank serves Ravi's token (expect 404)
POST {{baseUrl}}/api/tokens/{{joinRavi.response.body.$.id}}/serve
Authorization: Bearer {{bankToken}}

### 29. Ravi leaves the queue (public)
POST {{baseUrl}}/api/tokens/{{joinRavi.response.body.$.id}}/cancel

### 30. Customer join page still works (public)
GET {{baseUrl}}/api/queues/{{queueId}}

### 31. Reshma closes the queue for the day
POST {{baseUrl}}/api/queues/{{queueId}}/close
Authorization: Bearer {{staffToken}}

### 32. SignalR handshake (Lesson 11, public)
POST {{baseUrl}}/hubs/queue/negotiate?negotiateVersion=1

### 33. Owner reads the business profile (Lesson 13)
GET {{baseUrl}}/api/business
Authorization: Bearer {{ownerToken}}

### 34. Owner updates the business profile
PUT {{baseUrl}}/api/business
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Sunrise Clinic",
  "type": "Clinic",
  "address": "Main Road, Kalpetta",
  "openingHours": "Mon to Sat, 9 am to 5 pm"
}

### 35. Update with a made-up type number (expect 400)
PUT {{baseUrl}}/api/business
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Sunrise Clinic",
  "type": 99
}

### 36. Staff try to read the profile (expect 403)
GET {{baseUrl}}/api/business
Authorization: Bearer {{staffToken}}

### 37. The join page's data now includes the business (public)
GET {{baseUrl}}/api/queues/{{queueId}}

### 38. Owner renames the queue and changes its average time
PUT {{baseUrl}}/api/queues/{{queueId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "General OPD (Ground floor)",
  "averageServiceMinutes": 6
}

### 39. Settings with zero minutes (expect 400)
PUT {{baseUrl}}/api/queues/{{queueId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "General OPD",
  "averageServiceMinutes": 0
}

### 40. Staff try to change settings (expect 403)
PUT {{baseUrl}}/api/queues/{{queueId}}
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "name": "Renamed by staff",
  "averageServiceMinutes": 3
}

### 41. Owner lists staff
# @name staffList
GET {{baseUrl}}/api/staff
Authorization: Bearer {{ownerToken}}

### 42. Owner moves Reshma to Counter 3
PUT {{baseUrl}}/api/staff/{{staffList.response.body.$[0].id}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Reshma",
  "counterName": "Counter 3"
}

### 43. Staff try to list staff (expect 403)
GET {{baseUrl}}/api/staff
Authorization: Bearer {{staffToken}}

### 44. City Bank tries to edit Sunrise's staff (expect 404)
PUT {{baseUrl}}/api/staff/{{staffList.response.body.$[0].id}}
Authorization: Bearer {{bankToken}}
Content-Type: application/json

{
  "name": "Hacked",
  "counterName": "X"
}

### 45. Owner adds a temporary staff member
# @name tempStaff
POST {{baseUrl}}/api/staff
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Temp",
  "email": "temp@sunrise.test",
  "password": "test-password-6",
  "counterName": "Counter 9"
}

### 46. Temp logs in
# @name tempLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "temp@sunrise.test",
  "password": "test-password-6"
}

### 47. Temp's pass works
GET {{baseUrl}}/api/queues
Authorization: Bearer {{tempLogin.response.body.$.token}}

### 48. Owner removes Temp (expect 204)
DELETE {{baseUrl}}/api/staff/{{tempStaff.response.body.$.id}}
Authorization: Bearer {{ownerToken}}

### 49. Temp's old pass right after removal (expect 401)
GET {{baseUrl}}/api/queues
Authorization: Bearer {{tempLogin.response.body.$.token}}

### 50. TV display data (public, no pass)
GET {{baseUrl}}/api/queues/{{queueId}}/display
