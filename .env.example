# Settings QueueUp needs in production. Copy the names, never commit real values.

# --- API (Azure Container App: secrets / environment variables) ---
# Double underscore (__) means "inside a section", e.g. Jwt__SigningKey is Jwt:SigningKey.
ConnectionStrings__QueueUp=Server=tcp:<server>.database.windows.net,1433;Database=<database>;User ID=<user>;Password=<password>;Encrypt=True;
Jwt__SigningKey=<at least 32 random characters>
Cors__AllowedOrigins__0=https://<your-front-end-address>
Database__MigrateOnStartup=true

# --- Integration tests (optional; defaults to LocalDB) ---
QUEUEUP_TEST_SQL=Server=localhost,1433;User Id=sa;Password=<password>;TrustServerCertificate=True

# --- Front end (build time) ---
VITE_API_URL=https://<your-api-address>
