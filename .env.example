# Settings QueueUp needs in production. Copy the names, never commit real values.

# --- API (Render: environment variables) ---
# Double underscore (__) means "inside a section", e.g. Jwt__SigningKey is Jwt:SigningKey.
ConnectionStrings__QueueUp=Host=<neon-host>;Database=<database>;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Channel Binding=Require
Jwt__SigningKey=<at least 32 random characters>
Cors__AllowedOrigins__0=https://<your-front-end-address>
Database__MigrateOnStartup=true

# --- Integration tests (required to run them; a PostgreSQL server, no database name) ---
QUEUEUP_TEST_PG=Host=localhost;Username=postgres;Password=<password>

# --- Front end (build time) ---
VITE_API_URL=https://<your-api-address>
